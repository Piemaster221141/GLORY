--// Drawing helpers
local function createText()
    local text = Drawing.new("Text")
    text.Size = 16
    text.Center = true
    text.Outline = true
    text.Color = corpseESPColor
    text.OutlineColor = Color3.new(0, 0, 0)
    return text
end

local function createLine()
    local line = Drawing.new("Line")
    line.Thickness = 1.5
    line.Color = corpseESPColor
    line.Visible = true
    return line
end

local function createCircle()
    local circle = Drawing.new("Circle")
    circle.Radius = 4
    circle.Thickness = 1.5
    circle.Filled = true
    circle.Color = corpseESPColor
    circle.Visible = true
    return circle
end

--// ESP logic
local function renderCorpseESP(model, data)
    local root = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    if not root then return end

    local distance = (LocalPlayer.Character and LocalPlayer.Character.PrimaryPart and (LocalPlayer.Character.PrimaryPart.Position - root.Position).Magnitude) or 0
    if distance > corpseESPMaxDistance or not corpseESPEnabled then
        -- Hide everything if disabled or too far
        if data.text then data.text.Visible = false end
        if data.headdot then data.headdot.Visible = false end
        if data.skeleton then
            for _, line in pairs(data.skeleton) do
                line.Visible = false
            end
        end
        return
    end

    local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
    if onScreen then
        -- Text
        if not data.text then data.text = createText() end
        local namePart = corpseESPShowName and model.Name or ""
        local distPart = corpseESPShowDistance and string.format("%dm", math.floor(distance)) or ""
        local sep = (corpseESPShowName and corpseESPShowDistance) and "\n" or ""
        data.text.Text = namePart .. sep .. distPart
        data.text.Position = Vector2.new(screenPos.X, screenPos.Y)
        data.text.Color = corpseESPColor
        data.text.Visible = true

        -- Head dot
        if corpseESPShowHeadDot then
            local head = model:FindFirstChild("Head")
            if head then
                local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position)
                if not data.headdot then data.headdot = createCircle() end
                data.headdot.Position = Vector2.new(headPos.X, headPos.Y)
                data.headdot.Color = corpseESPColor
                data.headdot.Visible = headOnScreen
            elseif data.headdot then
                data.headdot.Visible = false
            end
        elseif data.headdot then
            data.headdot.Visible = false
        end

        -- Skeleton lines
        if corpseESPShowSkeleton then
            if not data.skeleton then data.skeleton = {} end
            for _, conn in pairs(skeletonConnections) do
                local partA = model:FindFirstChild(conn[1])
                local partB = model:FindFirstChild(conn[2])
                local key = conn[1] .. "-" .. conn[2]

                if partA and partB then
                    local aPos, aOn = Camera:WorldToViewportPoint(partA.Position)
                    local bPos, bOn = Camera:WorldToViewportPoint(partB.Position)

                    if aOn and bOn then
                        if not data.skeleton[key] then
                            data.skeleton[key] = createLine()
                        end
                        local line = data.skeleton[key]
                        line.From = Vector2.new(aPos.X, aPos.Y)
                        line.To = Vector2.new(bPos.X, bPos.Y)
                        line.Color = corpseESPColor
                        line.Visible = true
                    elseif data.skeleton[key] then
                        data.skeleton[key].Visible = false
                    end
                elseif data.skeleton[key] then
                    data.skeleton[key].Visible = false
                end
            end
        elseif data.skeleton then
            for _, line in pairs(data.skeleton) do
                line.Visible = false
            end
        end
    else
        if data.text then data.text.Visible = false end
        if data.headdot then data.headdot.Visible = false end
        if data.skeleton then
            for _, line in pairs(data.skeleton) do
                line.Visible = false
            end
        end
    end
end

--// Cleanup
local function cleanupDrawings()
    for model, draw in pairs(drawings) do
        if not model:IsDescendantOf(corpseFolder) then
            if draw.text then draw.text:Remove() end
            if draw.headdot then draw.headdot:Remove() end
            if draw.skeleton then
                for _, line in pairs(draw.skeleton) do
                    line:Remove()
                end
            end
            drawings[model] = nil
        end
    end
end

